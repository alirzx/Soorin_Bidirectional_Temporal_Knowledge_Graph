{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soorin.knowledge-context.v2",
  "type": "object",
  "required": [
    "schema_version",
    "query_id",
    "tenant_id",
    "knowledge_base_id",
    "resolved_entities",
    "facts",
    "evidence_references",
    "retrieval_status"
  ],
  "properties": {
    "schema_version": {
      "const": "soorin.knowledge-context.v2"
    },
    "query_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "knowledge_base_id": {
      "type": "string",
      "format": "uuid"
    },
    "requested_entity": {
      "type": "string"
    },
    "resolved_entities": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ]
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "recorded_at",
          "inferred"
        ]
      }
    },
    "evidence_references": {
      "type": "array",
      "maxItems": 800,
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "source"
        ]
      }
    },
    "retrieval_status": {
      "enum": [
        "complete",
        "partial",
        "fallback",
        "unavailable"
      ]
    },
    "valid_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "knowledge_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "bounds": {
      "type": "object",
      "required": [
        "truncated",
        "returned_count",
        "limit"
      ],
      "properties": {
        "truncated": {
          "type": "boolean"
        },
        "has_more": {
          "type": "boolean"
        },
        "returned_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "model_versions": {
      "type": "object"
    },
    "conflicts": {
      "type": "array"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retrieval_methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
