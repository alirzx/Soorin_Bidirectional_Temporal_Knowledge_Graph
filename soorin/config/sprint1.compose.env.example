# Soorin TKG isolated local source-build deployment.
# Copy to .env or use 'make env-init' to generate a strong password.
# Never commit .env; these settings are ONLY for docker-compose.soorin-dev.yml.
SOORIN_DEV_DB_PASSWORD=REPLACE_WITH_48_HEX_CHARACTERS
SOORIN_DEV_APP_BIND=127.0.0.1:2516
SOORIN_DEV_DB_BIND=127.0.0.1:2517
UTOPIA_DB_IMAGE=pgvector/pgvector:pg16
SOORIN_BUILD_JOBS=1
SOORIN_DEV_DB_MAX_CONNECTIONS=8
