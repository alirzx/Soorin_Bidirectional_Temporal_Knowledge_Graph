COMPOSE_PROJECT_NAME=soorin-tkg-v1-qa
# Soorin TKG isolated local source-build deployment.
# Use 'make qa-env-init' to generate a strong .env.qa; never overwrite an existing QA DB password.
# Never commit .env; these settings are ONLY for docker-compose.soorin-dev.yml.
SOORIN_DEV_DB_PASSWORD=REPLACE_WITH_48_HEX_CHARACTERS
SOORIN_DEV_APP_BIND=127.0.0.1:2526
SOORIN_DEV_DB_BIND=127.0.0.1:2527
UTOPIA_DB_IMAGE=pgvector/pgvector:pg16
SOORIN_BUILD_JOBS=1
SOORIN_DEV_DB_MAX_CONNECTIONS=8

# Build-only mirrors. Keep Rust and Debian runtime on compatible Bookworm.
# Arvan is a Docker registry proxy, not automatically a verified APT repository.
SOORIN_NODE_BASE_IMAGE=docker.arvancloud.ir/node:20-slim
SOORIN_RUST_BASE_IMAGE=docker.arvancloud.ir/rust:1.99.1-slim-bookworm
SOORIN_DEBIAN_BASE_IMAGE=docker.arvancloud.ir/debian:bookworm-slim
SOORIN_PYTHON_BASE_IMAGE=docker.arvancloud.ir/python:3.12-slim-bookworm
APT_PRIMARY_DEBIAN_URL=https://mirror.arvancloud.ir/debian
APT_PRIMARY_SECURITY_URL=https://mirror.arvancloud.ir/debian-security
APT_FALLBACK_DEBIAN_URL=https://mirror.metanet.ch/debian
APT_FALLBACK_SECURITY_URL=https://mirror.metanet.ch/debian-security
APT_LAST_DEBIAN_URL=https://mirrors.huaweicloud.com/repository/debian
APT_LAST_SECURITY_URL=https://mirrors.huaweicloud.com/repository/debian-security
NPM_REGISTRY_URL=https://package-mirror.liara.ir/repository/npm/
NPM_FALLBACK_REGISTRY_URL=https://registry.npmjs.org/
PIP_PRIMARY_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple
PIP_FALLBACK_INDEX_URL=https://mirror2.chabokan.net/pypi/simple/
TORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
