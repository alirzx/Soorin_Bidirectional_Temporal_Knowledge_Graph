# PLACEHOLDERS ONLY. Replace before deployment; protect real file mode 0600.
# Image references are intentionally invalid until qualified images are supplied.
SOORIN_IMAGE=REPLACE_WITH_SOORIN_IMAGE_AT_SHA256
SOORIN_DB_IMAGE=REPLACE_WITH_PGVECTOR_IMAGE_AT_SHA256
SOORIN_MODEL_IMAGE=REPLACE_WITH_CPU_IMAGE_AT_SHA256
SOORIN_DB_OWNER_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
SOORIN_DB_RUNTIME_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_RUNTIME_PASSWORD
# URL-encode passwords in URLs. Provision utopia_app before migrations on upgrades.
SOORIN_RUNTIME_DATABASE_URL=postgres://utopia_app:REPLACE_URL_ENCODED_RUNTIME_PASSWORD@db:5432/utopia
SOORIN_MIGRATION_DATABASE_URL=postgres://utopia:REPLACE_URL_ENCODED_OWNER_PASSWORD@db:5432/utopia
SOORIN_DB_MAX_CONNECTIONS=16
SOORIN_PUBLIC_ORIGIN=https://soorin.example.invalid
UTOPIA_JWT_SECRET=REPLACE_WITH_RANDOM_SIGNING_SECRET
UTOPIA_SECRET_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Optional model profiles; endpoint origin authorization does not enable a model.
UTOPIA_MODEL_TRUSTED_ORIGINS=http://embedding:8080,http://reranker:8080,http://ner:8080
UTOPIA_PRIVACY_GATEWAY_URL=
UTOPIA_PRIVACY_GATEWAY_KEY=
UTOPIA_PRIVACY_TENANT_MAP=
UTOPIA_PRIVACY_PROVIDER_ORIGINS=
UTOPIA_PRIVACY_PROFILE=agentic-soc-v1
# Workspace model IDs/revisions are configured via soorin.ops.models, not these env vars.
# TLS terminates at a host proxy; forward / to 127.0.0.1:2516 and X-Forwarded-Proto=https.
# Backup identity must be separately provisioned; never reuse runtime credentials.

# Loopback publication for an approved TLS reverse proxy; verify port availability.
SOORIN_APP_BIND=127.0.0.1:2516
