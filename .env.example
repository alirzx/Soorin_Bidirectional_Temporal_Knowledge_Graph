# Canonical source build. Copy to .env (0600). Fill all empty required entries.
COMPOSE_PROJECT_NAME=soorin-tkg-local
SOORIN_VOLUME_MODE=preserve
# Explicit Docker volume names required in both modes.
SOORIN_PROD_DB_VOLUME=
SOORIN_PROD_DATA_VOLUME=
# Existing caches. Empty selects <project>_soorin_<role>_cache.
SOORIN_EMBEDDING_CACHE_VOLUME=
SOORIN_RERANKER_CACHE_VOLUME=
SOORIN_NER_CACHE_VOLUME=

# Default: TLS proxy -> loopback app. Explicit lan-http allows a direct private
# IP or loopback bind with a matching http:// origin (synthetic data only).
SOORIN_ACCESS_MODE=https-proxy
# PostgreSQL is accessible only as db:5432 internally.
SOORIN_APP_BIND=127.0.0.1:2516
SOORIN_PUBLIC_ORIGIN=https://localhost
SOORIN_DB_MAX_CONNECTIONS=16
SOORIN_DB_OWNER_PASSWORD=
SOORIN_DB_RUNTIME_PASSWORD=
# Supply matching percent-encoded passwords. Use distinct passwords for the roles.
SOORIN_RUNTIME_DATABASE_URL=
SOORIN_MIGRATION_DATABASE_URL=
UTOPIA_JWT_SECRET=
UTOPIA_SECRET_KEY=

# Pin qualified PG16 pgvector and nginx images by digest. Stage both on the host.
SOORIN_DB_IMAGE=
SOORIN_MODEL_PROXY_IMAGE=
# Both builds stamp HEAD. To reuse a qualified older CPU image, supply its full SHA.
SOORIN_MODEL_BUILD_REVISION=${SOORIN_BUILD_REVISION:-unbuilt}
SOORIN_IMAGE=soorin-tkg-app:${SOORIN_BUILD_REVISION:-unbuilt}
SOORIN_CPU_MODEL_IMAGE=soorin-tkg-cpu:${SOORIN_MODEL_BUILD_REVISION}
SOORIN_BUILD_JOBS=1
SOORIN_NODE_BASE_IMAGE=docker.arvancloud.ir/node:20-slim
SOORIN_RUST_BASE_IMAGE=docker.arvancloud.ir/rust:1.99.1-slim-bookworm
SOORIN_DEBIAN_BASE_IMAGE=docker.arvancloud.ir/debian:bookworm-slim
SOORIN_PYTHON_BASE_IMAGE=docker.arvancloud.ir/python:3.12-slim-bookworm
NPM_REGISTRY_URL=https://package-mirror.liara.ir/repository/npm/
NPM_FALLBACK_REGISTRY_URL=https://registry.npmjs.org/
APT_PRIMARY_DEBIAN_URL=https://mirror.arvancloud.ir/debian
APT_PRIMARY_SECURITY_URL=https://mirror.arvancloud.ir/debian-security
APT_FALLBACK_DEBIAN_URL=https://mirror.metanet.ch/debian
APT_FALLBACK_SECURITY_URL=https://mirror.metanet.ch/debian-security
APT_LAST_DEBIAN_URL=https://mirrors.huaweicloud.com/repository/debian
APT_LAST_SECURITY_URL=https://mirrors.huaweicloud.com/repository/debian-security
PIP_PRIMARY_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple
PIP_FALLBACK_INDEX_URL=https://mirror2.chabokan.net/pypi/simple/
TORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu

SOORIN_EMBEDDING_CPUS=1.20
SOORIN_EMBEDDING_MEMORY=3g
SOORIN_EMBEDDING_MODEL_THREADS=1
SOORIN_EMBEDDING_MODEL_QUEUE_CAPACITY=2
SOORIN_EMBEDDING_MODEL_QUEUE_TIMEOUT_SECONDS=6
SOORIN_RERANKER_CPUS=1.40
SOORIN_RERANKER_MEMORY=3g
SOORIN_RERANKER_MODEL_THREADS=1
SOORIN_RERANKER_MODEL_QUEUE_CAPACITY=1
SOORIN_RERANKER_MODEL_QUEUE_TIMEOUT_SECONDS=3
SOORIN_RERANK_BATCH_SIZE=8
SOORIN_RERANK_MAX_CANDIDATES=16
SOORIN_RERANK_TIMEOUT_SECONDS=18
SOORIN_RERANK_DEADLINE_SECONDS=30
SOORIN_ENABLE_NER=off
SOORIN_MODEL_DIAGNOSTICS=off
SOORIN_EMBEDDING_DIAGNOSTIC_PORT=2811
SOORIN_RERANKER_DIAGNOSTIC_PORT=2812
SOORIN_SOC_INTEGRATION=off
# Optional external-provider DLP settings. Supply only with an approved reachable gateway.
UTOPIA_PRIVACY_GATEWAY_URL=
UTOPIA_PRIVACY_GATEWAY_KEY=
UTOPIA_PRIVACY_TENANT_MAP=
UTOPIA_PRIVACY_PROVIDER_ORIGINS=
UTOPIA_PRIVACY_PROFILE=agentic-soc-v1

# Optional app retrieval budgets (JSON keyed by pinned model identity)
UTOPIA_MODEL_READ_SECONDS=
UTOPIA_EMBED_BATCH_LIMITS=
SOORIN_MODEL_LOG_LEVEL=INFO

# Native-development / legacy Compose options. The source runner sets its own
# in-container addresses and always closes registration after first bootstrap.
# UTOPIA_DATABASE_URL=
# UTOPIA_BIND_ADDR=127.0.0.1:1516
# UTOPIA_WEB_DIST=web/dist
# UTOPIA_DATA_DIR=data
# UTOPIA_DB_PASSWORD=
# UTOPIA_DB_BIND=127.0.0.1:1517
# UTOPIA_DB_IMAGE=pgvector/pgvector:pg16
# UTOPIA_APP_DB_PASSWORD=
# UTOPIA_MIGRATION_URL=
# UTOPIA_OIDC_ISSUER=
# UTOPIA_OIDC_CLIENT_ID=
# UTOPIA_OIDC_CLIENT_SECRET=
# UTOPIA_OIDC_REDIRECT_URI=
# UTOPIA_OIDC_EXCHANGE_AUDIENCES=
